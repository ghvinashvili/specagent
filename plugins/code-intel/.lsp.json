{
  "pyright": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lsp",
    "args": ["pyright-langserver", "--stdio"],
    "extensionToLanguage": { ".py": "python", ".pyi": "python" }
  },
  "typescript": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lsp",
    "args": ["typescript-language-server", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript",
      ".cjs": "javascript"
    }
  },
  "intelephense": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lsp",
    "args": ["intelephense", "--stdio"],
    "extensionToLanguage": { ".php": "php" }
  },
  "clangd": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lsp",
    "args": ["clangd", "--background-index"],
    "extensionToLanguage": {
      ".c": "c",
      ".h": "c",
      ".cpp": "cpp",
      ".cc": "cpp",
      ".cxx": "cpp",
      ".hpp": "cpp",
      ".hxx": "cpp"
    }
  },
  "html": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lsp",
    "args": ["vscode-html-language-server", "--stdio"],
    "extensionToLanguage": { ".html": "html", ".htm": "html" }
  },
  "css": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lsp",
    "args": ["vscode-css-language-server", "--stdio"],
    "extensionToLanguage": { ".css": "css", ".scss": "scss", ".less": "less" }
  }
}
