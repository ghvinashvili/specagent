{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/wiki-page.schema.json",
  "title": "Wiki page frontmatter (wiki/{concepts,entities,sources,decisions}/*.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "type",
    "status",
    "updated"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "concept",
        "entity",
        "source",
        "decision"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "disputed",
        "stale"
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "expires": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^sources/[a-z0-9-]+\\.md$"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(concepts|entities|sources|decisions)/[a-z0-9-]+\\.md$"
      }
    },
    "source_kind": {
      "enum": [
        "document",
        "code",
        "data",
        "transcript",
        "web"
      ]
    },
    "raw": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^context/"
      }
    },
    "decided": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "would_change_if": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decision_status": {
      "enum": [
        "decided",
        "revised",
        "withdrawn"
      ]
    },
    "scope": {
      "enum": [
        "project",
        "global"
      ]
    },
    "revised_by": {
      "type": "string",
      "pattern": "^decisions/[a-z0-9-]+\\.md$"
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "the day the page was first written (claude-obsidian lint requires it)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Obsidian tags; at least the page's kind (claude-obsidian lint requires it)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "source"
          }
        }
      },
      "then": {
        "required": [
          "raw",
          "source_kind"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "concept",
              "entity"
            ]
          }
        }
      },
      "then": {
        "required": [
          "sources"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision"
          }
        }
      },
      "then": {
        "required": [
          "decided",
          "by",
          "why",
          "would_change_if",
          "decision_status",
          "scope"
        ]
      }
    },
    {
      "if": {
        "required": [
          "decision_status"
        ],
        "properties": {
          "decision_status": {
            "const": "revised"
          }
        }
      },
      "then": {
        "required": [
          "revised_by"
        ]
      }
    }
  ]
}
