{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/stages.schema.json",
  "title": "Stage table (docs/roles/stages.yaml and docs/roles/pipelines/*.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stages", "no_match"],
  "properties": {
    "version": { "const": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role_type", "mode", "model", "effort", "inputs", "output", "gate", "approval", "permission_mode", "max_minutes", "max_attempts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "role_type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "mode": { "enum": ["bg", "print"] },
          "model": { "type": "string", "minLength": 1 },
          "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
          "max_shards": { "type": "integer", "minimum": 1 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "output": { "type": "string" },
          "gate": { "type": "string" },
          "parallel": { "enum": ["none", "per_task"] },
          "parallel_with": { "type": "array", "items": { "type": "string" } },
          "approval": { "enum": ["none", "human"] },
          "permission_mode": { "enum": ["default", "acceptEdits", "dontAsk", "auto", "bypassPermissions", "plan"] },
          "max_minutes": { "type": "integer", "minimum": 1 },
          "max_attempts": { "type": "integer", "minimum": 1 },
          "json_schema": { "type": "string" },
          "max_budget_usd": { "type": "number", "minimum": 0 },
          "max_turns": { "type": "integer", "minimum": 1 },
          "returns_to": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "counter"],
            "description": "A reviewer whose verdict `revise` sends its proven findings back to this stage, counted on this counter.",
            "properties": {
              "stage": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
              "counter": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
            }
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bounds of the loops inside a run (harness/rounds.py, docs/decisions/0024): rounds per counter, starts per stage.",
      "properties": {
        "counters": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "max_runs": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "labels"],
      "properties": {
        "stage": { "type": "string" },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "no_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "message"],
      "properties": {
        "action": { "enum": ["escalate"] },
        "message": { "type": "string" }
      }
    }
  }
}
