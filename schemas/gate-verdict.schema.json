{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/gate-verdict.schema.json",
  "title": "Gate verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "stage", "gate", "passed", "checks", "checked_at", "next"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string" },
    "stage": { "type": "string" },
    "gate": { "type": "string" },
    "passed": { "type": "boolean" },
    "checked_at": { "type": "string", "format": "date-time" },
    "checks": { "type": "array", "items": { "$ref": "#/definitions/check" } },
    "next": { "enum": ["advance", "retry", "escalate", "abort"] },
    "shard": { "type": "integer", "minimum": 1 },
    "steps_mode": {
      "enum": ["warn", "enforce"],
      "description": "How the checks of specs/001-chat-depth counted: in `checks` (enforce) or in `advisory` (warn)."
    },
    "advisory": {
      "type": "array",
      "items": { "$ref": "#/definitions/check" },
      "description": "warn: the checks of specs/001-chat-depth, recorded for the human and not counted in `passed`."
    }
  },
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed"],
      "properties": {
        "name": { "type": "string" },
        "passed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    }
  }
}
