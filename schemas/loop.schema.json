{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/loop.schema.json",
  "title": "Loop specification (docs/loops/<name>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "enabled", "purpose", "goal", "action", "trigger", "stops", "exit", "readiness", "owner"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "enabled": { "type": "boolean" },
    "purpose": { "type": "string", "minLength": 10 },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "done_when"],
      "properties": {
        "statement": { "type": "string", "minLength": 10 },
        "done_when": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "rubric": { "type": "string", "pattern": "^evals/rubrics/.+\\.md$" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["pipeline", "command", "prompt", "ci"] },
        "pipeline": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "command": { "type": "string" },
        "file": { "type": "string" },
        "context": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["manual", "session", "local-cron", "ci-cron"] },
        "schedule": { "type": "string" }
      }
    },
    "stops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations", "max_minutes", "no_progress_after"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1 },
        "max_minutes": { "type": "integer", "minimum": 1 },
        "max_usd": { "type": "number", "minimum": 0 },
        "no_progress_after": { "type": "integer", "minimum": 1 }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "failure"],
      "properties": {
        "success": { "type": "string" },
        "failure": { "type": "string" },
        "check": {
          "enum": ["no_active_runs"],
          "description": "the condition harness loop tick checks for `success` at every tick of a prompt loop (docs/decisions/0022-a-prompt-loop-is-judged-by-code.md)"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeats_weekly", "verification_is_automatic", "budget_tolerates_waste", "agent_can_run_the_check"],
      "properties": {
        "repeats_weekly": { "$ref": "#/definitions/condition" },
        "verification_is_automatic": { "$ref": "#/definitions/condition" },
        "budget_tolerates_waste": { "$ref": "#/definitions/condition" },
        "agent_can_run_the_check": { "$ref": "#/definitions/condition" }
      }
    },
    "owner": { "type": "string" }
  },
  "if": { "properties": { "action": { "properties": { "kind": { "const": "prompt" } } } } },
  "then": { "properties": { "exit": { "required": ["check"] } } },
  "definitions": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["met", "evidence"],
      "properties": {
        "met": { "type": "boolean" },
        "evidence": { "type": "string", "minLength": 5 }
      }
    }
  }
}
