# Large binary material is kept out of git history with Git LFS. Text stays in git: sessions read and search it.
context/**/*.parquet filter=lfs diff=lfs merge=lfs -text
context/**/*.zip filter=lfs diff=lfs merge=lfs -text
evals/**/fixture/**/*.bin filter=lfs diff=lfs merge=lfs -text
* text=auto eol=lf
