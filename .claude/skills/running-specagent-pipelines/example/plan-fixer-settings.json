{
  "model": "<model>",
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<checkout>/.claude/hooks/guard-read.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<checkout>/.claude/hooks/guard-records.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Bash",
      "SendMessage",
      "ListAgents",
      "ToolSearch"
    ],
    "deny": [
      "Agent",
      "EnterWorktree",
      "AskUserQuestion",
      "Edit(/<run-dir>/_*)",
      "Write(/<run-dir>/_*)",
      "Read(~/.config/**)",
      "Bash(cat ~/.config/*)",
      "Edit(/<vault>/**)",
      "Write(/<vault>/**)",
      "Edit(/<sources>/**)",
      "Write(/<sources>/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Edit(/<checkout>/<checkout-entry>/**)",
      "Edit(/<checkout>/<checkout-file>)",
      "Edit(/<checkout>/.git/hooks/**)",
      "Edit(/<checkout>/.git/config)",
      "Write(/<checkout>/<checkout-entry>/**)",
      "Write(/<checkout>/<checkout-file>)",
      "Write(/<checkout>/.git/hooks/**)",
      "Write(/<checkout>/.git/config)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git worktree:*)",
      "Bash(git stash:*)",
      "Bash(git commit --amend:*)",
      "Edit(/<worktree-a>/**)",
      "Write(/<worktree-a>/**)",
      "Edit(/<worktree-b>/**)",
      "Write(/<worktree-b>/**)",
      "Edit(/<verify-worktree>/**)",
      "Write(/<verify-worktree>/**)",
      "Edit(/<plan-worktree>/packages/**)",
      "Write(/<plan-worktree>/packages/**)",
      "Edit(/<plan-worktree>/.claude/**)",
      "Write(/<plan-worktree>/.claude/**)",
      "Edit(/<plan-worktree>/ops/**)",
      "Write(/<plan-worktree>/ops/**)",
      "Edit(/<plan-worktree>/plugins/**)",
      "Write(/<plan-worktree>/plugins/**)",
      "Edit(/<plan-worktree>/schemas/**)",
      "Write(/<plan-worktree>/schemas/**)",
      "Edit(/<plan-worktree>/specs/**)",
      "Write(/<plan-worktree>/specs/**)",
      "Edit(/<plan-worktree>/evals/**)",
      "Write(/<plan-worktree>/evals/**)",
      "Edit(/<plan-worktree>/context/**)",
      "Write(/<plan-worktree>/context/**)",
      "Edit(/<plan-worktree>/wiki/**)",
      "Write(/<plan-worktree>/wiki/**)",
      "Edit(/<plan-worktree>/design/**)",
      "Write(/<plan-worktree>/design/**)",
      "Edit(/<plan-worktree>/templates/**)",
      "Write(/<plan-worktree>/templates/**)",
      "Edit(/<plan-worktree>/docs/decisions/**)",
      "Write(/<plan-worktree>/docs/decisions/**)",
      "Edit(/<plan-worktree>/docs/architecture/**)",
      "Write(/<plan-worktree>/docs/architecture/**)",
      "Edit(/<plan-worktree>/docs/roles/**)",
      "Write(/<plan-worktree>/docs/roles/**)",
      "Edit(/<plan-worktree>/docs/loops/**)",
      "Write(/<plan-worktree>/docs/loops/**)",
      "Edit(/<plan-worktree>/docs/quality/**)",
      "Write(/<plan-worktree>/docs/quality/**)",
      "Read(~/.claude/projects/**)",
      "Read(/<run-dir>/_control/**)",
      "Read(/<checkout>/docs/handoff/**)",
      "Read(//proc/**)",
      "Bash(claude agents:*)",
      "Bash(claude logs:*)",
      "Bash(claude attach:*)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "<plan-worktree>",
        "<run-dir>",
        "~/.cache",
        "~/.local/share/uv",
        "~/.npm",
        "<checkout>/.git"
      ],
      "denyRead": [
        "~/.config",
        "~/.claude/projects",
        "~/.claude/agent-memory",
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "<run-dir>/_control",
        "<checkout>/docs/handoff",
        "~/.claude/.credentials.json"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "objects.githubusercontent.com",
        "releases.astral.sh",
        "code.claude.com",
        "platform.claude.com",
        "registry.npmjs.org"
      ]
    }
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "",
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "1h"
  },
  "crossSessionInbound": "accept"
}
