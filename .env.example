# Copy to .env and fill in. .env is gitignored and denied to Claude (see .claude/settings.json).
# Model access for CI (GitHub Actions) and for `harness eval` run from a human shell.
# Sessions the manager launches do not see this variable: CLAUDE_CODE_SUBPROCESS_ENV_SCRUB strips
# credentials from Bash subprocesses, so they use the container user's stored `claude` login.
ANTHROPIC_API_KEY=
# Optional: OTLP endpoint the harness CLI exports its own spans to (Claude Code's OTEL_* vars are not inherited by subprocesses).
HARNESS_OTEL_ENDPOINT=
# Optional: command that receives one line on its standard input whenever a run needs a human or finishes
# (harness poll, the Notification hook, night ticks). Export it in the shell that starts the manager and in the crontab.
HARNESS_NOTIFY_CMD=
# Optional: product configuration
INGEST_DATABASE_URL=
